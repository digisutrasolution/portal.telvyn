// Telvyn auth domain (Phase 2). Conventions per constitution: UUIDv7 PKs
// (PostgreSQL 18 native uuidv7()), audit timestamps, soft delete on business
// entities, FKs + indexes everywhere. `tenantId` is a reserved nullable
// column: the Phase 3 tenancy migration (DB-002 ADR) populates and constrains
// it additively — the documented backward-compatible path.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model User {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Primary/home tenant (ADR-0004): the tenant a session defaults to at login.
  // Access to any tenant is granted via Membership, never by this column alone.
  tenantId        String?    @db.Uuid
  primaryTenant   Tenant?    @relation("UserPrimaryTenant", fields: [tenantId], references: [id])
  email           String     @unique
  passwordHash    String
  fullName        String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean    @default(false)
  mfaSecretEnc    String? // AES-256-GCM under APP_ENCRYPTION_KEY (secret-manager upgrade path in SECURITY.md)
  failedLogins    Int        @default(0)
  lockedUntil     DateTime?

  sessions       Session[]
  emailTokens    EmailToken[]
  recoveryCodes  MfaRecoveryCode[]
  loginAttempts  LoginAttempt[]
  securityEvents SecurityEvent[]
  memberships    Membership[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Tenancy & RBAC (ADR-0004). Tenant isolation is enforced server-side: the
// tenant id is derived from the session's membership, never from the client.
// ---------------------------------------------------------------------------

enum TenantType {
  PLATFORM // the operator's own tenant
  RESELLER
  CUSTOMER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model Tenant {
  id       String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug     String       @unique
  name     String
  type     TenantType   @default(CUSTOMER)
  status   TenantStatus @default(ACTIVE)

  memberships   Membership[]
  roles         Role[]
  primaryUsers  User[]       @relation("UserPrimaryTenant")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

// A user's access to a tenant. Roles are assigned per membership (per tenant),
// so the same user can hold different roles in different tenants.
model Membership {
  id       String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId   String           @db.Uuid
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String           @db.Uuid
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status   MembershipStatus @default(ACTIVE)

  roles MembershipRole[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// A role. tenantId null + isSystem = a shared system-role template; a row with
// tenantId set + isSystem false = a tenant's CUSTOM role.
model Role {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String? @db.Uuid
  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String?
  isSystem    Boolean @default(false)

  permissions     RolePermission[]
  membershipRoles MembershipRole[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, key])
}

model PermissionGroup {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String       @unique
  name        String
  description String?
  permissions Permission[]

  createdAt DateTime @default(now())
}

// Resource + action permission. `key` = "resource.action" (e.g. did.assign).
model Permission {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String           @unique
  resource    String
  action      String
  description String
  groupId     String?          @db.Uuid
  group       PermissionGroup? @relation(fields: [groupId], references: [id])

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@index([resource])
}

model RolePermission {
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MembershipRole {
  membershipId String     @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

// Tenant-scoped mutation audit trail (constitution: audit all mutations).
model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String?  @db.Uuid
  actorId    String?  @db.Uuid
  action     String // e.g. tenant.created, role.created, membership.role_assigned
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([resource, resourceId])
}

model Session {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Active tenant for this session (ADR-0004) — set server-side at login.
  tenantId      String?   @db.Uuid
  deviceLabel   String?
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  lastSeenAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// Rotation chain: each refresh marks the presented token used and issues a
// successor. A presented token that is already used = reuse → revoke session.
model RefreshToken {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId    String    @db.Uuid
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique // sha256 — raw token never stored
  expiresAt    DateTime
  usedAt       DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([sessionId])
  @@index([expiresAt])
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model EmailToken {
  id        String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginAttempt {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String?  @db.Uuid
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  emailTried    String
  success       Boolean
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([emailTried, createdAt])
}

// Auth-domain audit trail (constitution: audit on all mutations).
model SecurityEvent {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String // e.g. auth.login, auth.refresh_reuse, auth.mfa_enabled
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

// Honest email seam: rows are queued here; SMTP/worker wiring is deploy
// configuration (Phase 20). Bodies contain links with raw tokens — the DB
// stores those message bodies transiently; delivery worker purges on send.
model EmailOutbox {
  id        String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  toEmail   String
  subject   String
  body      String
  purpose   String
  status    OutboxStatus @default(PENDING)
  createdAt DateTime     @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}
