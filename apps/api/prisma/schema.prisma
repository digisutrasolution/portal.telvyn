// Telvyn auth domain (Phase 2). Conventions per constitution: UUIDv7 PKs
// (PostgreSQL 18 native uuidv7()), audit timestamps, soft delete on business
// entities, FKs + indexes everywhere. `tenantId` is a reserved nullable
// column: the Phase 3 tenancy migration (DB-002 ADR) populates and constrains
// it additively — the documented backward-compatible path.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model User {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Primary/home tenant (ADR-0004): the tenant a session defaults to at login.
  // Access to any tenant is granted via Membership, never by this column alone.
  tenantId        String?    @db.Uuid
  primaryTenant   Tenant?    @relation("UserPrimaryTenant", fields: [tenantId], references: [id])
  email           String     @unique
  passwordHash    String
  fullName        String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean    @default(false)
  mfaSecretEnc    String? // AES-256-GCM under APP_ENCRYPTION_KEY (secret-manager upgrade path in SECURITY.md)
  // TOTP replay guard (ADR-0022 Amendment 5 BA-15, Phase 13-2B S1): the last
  // accepted absolute TOTP time step; a code is accepted only for a greater step.
  mfaLastTotpStep Int?
  failedLogins    Int        @default(0)
  lockedUntil     DateTime?

  sessions       Session[]
  emailTokens    EmailToken[]
  recoveryCodes  MfaRecoveryCode[]
  loginAttempts  LoginAttempt[]
  securityEvents SecurityEvent[]
  memberships    Membership[]
  stepUpGrants   StepUpGrant[]
  // Financial audit (Phase 13-2B S2, BA-14): events this user performed (FK RESTRICT).
  financialAuditEvents FinancialAuditEvent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Tenancy & RBAC (ADR-0004). Tenant isolation is enforced server-side: the
// tenant id is derived from the session's membership, never from the client.
// ---------------------------------------------------------------------------

enum TenantType {
  PLATFORM // the operator's own tenant
  RESELLER
  CUSTOMER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model Tenant {
  id     String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug   String       @unique
  name   String
  type   TenantType   @default(CUSTOMER)
  status TenantStatus @default(ACTIVE)

  memberships  Membership[]
  roles        Role[]
  primaryUsers User[]       @relation("UserPrimaryTenant")

  // Telecom control plane (Phase 12). Back-relations only — no new column on Tenant.
  carriers                  Carrier[]
  sipTrunks                 SipTrunk[]
  dids                      Did[]
  routingProfiles           RoutingProfile[]
  telecomCredentials        TelecomCredential[]
  lcrPolicies               LcrPolicy[]
  engineResourceAssignments EngineResourceAssignment[]

  // Fraud control plane (Phase 12R). Back-relations only — no new column on Tenant.
  fraudEvents       FraudEvent[]
  spendLimits       SpendLimit[]
  velocityLimits    VelocityLimit[]
  destinationRules  DestinationRule[]
  killSwitches      KillSwitch[]
  spendReservations SpendReservation[]
  stepUpGrants      StepUpGrant[]

  // Billing ledger foundation (Phase 13, Slice 13-1; ADR-0022 / LEDGER_FOUNDATION).
  // Back-relations only — no new column on Tenant. Dual-nature ledger (ADR-0008):
  // these relations carry only the TENANT-owned ledger rows; platform-owned rows
  // (null tenant) have no Tenant parent. FKs are ON DELETE RESTRICT (financial
  // history is never cascade-deleted).
  ledgerAccounts     LedgerAccount[]
  ledgerTransactions LedgerTransaction[]
  idempotencyKeys    IdempotencyKey[]

  // Commercial billing accounts (Phase 13-2B S3; ADR-0022 Amendment 5 BA-01).
  // Back-relation only — no new column on Tenant. FK is ON DELETE RESTRICT.
  billingAccounts BillingAccount[]

  // Financial audit (Phase 13-2B S2; BA-14, owner decisions F3/F4). Back-relations
  // only — no new column on Tenant. FKs are ON DELETE RESTRICT (audit is evidence).
  financialAuditEventsOwned FinancialAuditEvent[] @relation("FinancialAuditOwnerTenant")
  financialAuditEventsActed FinancialAuditEvent[] @relation("FinancialAuditActorTenant")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

// A user's access to a tenant. Roles are assigned per membership (per tenant),
// so the same user can hold different roles in different tenants.
model Membership {
  id       String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId   String           @db.Uuid
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String           @db.Uuid
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status   MembershipStatus @default(ACTIVE)

  roles MembershipRole[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// A role. tenantId null + isSystem = a shared system-role template; a row with
// tenantId set + isSystem false = a tenant's CUSTOM role.
model Role {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String? @db.Uuid
  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String?
  isSystem    Boolean @default(false)

  permissions     RolePermission[]
  membershipRoles MembershipRole[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, key])
}

model PermissionGroup {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String       @unique
  name        String
  description String?
  permissions Permission[]

  createdAt DateTime @default(now())
}

// Resource + action permission. `key` = "resource.action" (e.g. did.assign).
model Permission {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String           @unique
  resource    String
  action      String
  description String
  groupId     String?          @db.Uuid
  group       PermissionGroup? @relation(fields: [groupId], references: [id])

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@index([resource])
}

model RolePermission {
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MembershipRole {
  membershipId String     @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

// Tenant-scoped mutation audit trail (constitution: audit all mutations).
model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String?  @db.Uuid
  actorId    String?  @db.Uuid
  action     String // e.g. tenant.created, role.created, membership.role_assigned
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([resource, resourceId])
}

model Session {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Active tenant for this session (ADR-0004) — set server-side at login.
  tenantId      String?   @db.Uuid
  deviceLabel   String?
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  lastSeenAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())

  refreshTokens RefreshToken[]
  stepUpGrants  StepUpGrant[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// Rotation chain: each refresh marks the presented token used and issues a
// successor. A presented token that is already used = reuse → revoke session.
model RefreshToken {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId    String    @db.Uuid
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique // sha256 — raw token never stored
  expiresAt    DateTime
  usedAt       DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([sessionId])
  @@index([expiresAt])
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model EmailToken {
  id        String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginAttempt {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String?  @db.Uuid
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  emailTried    String
  success       Boolean
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([emailTried, createdAt])
}

// Auth-domain audit trail (constitution: audit on all mutations).
model SecurityEvent {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String // e.g. auth.login, auth.refresh_reuse, auth.mfa_enabled
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

// Honest email seam: rows are queued here; SMTP/worker wiring is deploy
// configuration (Phase 20). Bodies contain links with raw tokens — the DB
// stores those message bodies transiently; delivery worker purges on send.
model EmailOutbox {
  id        String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  toEmail   String
  subject   String
  body      String
  purpose   String
  status    OutboxStatus @default(PENDING)
  createdAt DateTime     @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

// ===========================================================================
// TELECOM CONTROL PLANE (Phase 12 — ADR-0006..0010).
// Control-plane CONFIGURATION only; no SIP/RTP execution lives here. Runtime
// concepts (Registration, CallSession) are NOT persisted (data plane).
// Secret material lives ONLY in TelecomCredential (AES-256-GCM); config tables
// reference a credentialId — never a plaintext secret.
// ===========================================================================

enum TelecomEngineType {
  KAMAILIO
  ASTERISK
  FREESWITCH
}

enum TelecomEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

// Administrative status of a telecom resource (config), distinct from health.
enum TelecomStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

// Runtime health (ADR-0010). UNKNOWN until a real adapter probe exists.
enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
  DISABLED
}

// Explicit engine capabilities (ADR-0007) — never inferred from engine type.
enum EngineCapabilityKey {
  SIP
  RTP
  WEBRTC
  REGISTRATION
  INBOUND_CALLS
  OUTBOUND_CALLS
  IVR
  RECORDING
  TRANSCRIPTION
  TTS
  SRTP
  TLS
  CALL_TRANSFER
  CALL_FORWARDING
}

enum Codec {
  PCMU
  PCMA
  G722
  G729
  OPUS
  AMR
  AMR_WB
}

enum CarrierType {
  ORIGINATION
  TERMINATION
  BIDIRECTIONAL
}

enum SipTransport {
  UDP
  TCP
  TLS
}

enum SipTrunkDirection {
  INBOUND
  OUTBOUND
  BIDIRECTIONAL
}

enum SipAuthMode {
  IP
  CREDENTIALS
}

// DID lifecycle (per constitution + owner-approved set). Transitions are
// guarded + audited; engine execution is deferred to a later phase.
enum DidStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
  ACTIVE
  SUSPENDED
  PORTING
  RELEASED
}

enum RoutingDirection {
  INBOUND
  OUTBOUND
}

// Declarative routing destination types (Phase 12H). No AI/application target
// yet (deferred). Each type constrains how `RoutingRule.destination` is
// validated; webhook targets are SSRF-validated as config (never called in 12H).
enum RoutingDestinationType {
  SIP_TRUNK
  PHONE_NUMBER
  EXTENSION
  VOICEMAIL
  WEBHOOK
}

// Routing policy semantics (Phase 12I) — declarative selection strategy for a
// profile's rules. Runtime evaluation is a FUTURE engine-adapter concern.
enum RoutingSelectionStrategy {
  PRIORITY // try rules in deterministic priority order
  WEIGHTED // distribute by RoutingRule.weight (config only)
  ROUND_ROBIN
  SIMULTANEOUS // ring eligible destinations at once
}

// Declarative failure conditions that would trigger failover (config only).
enum RoutingFailoverCondition {
  NO_ANSWER
  BUSY
  FAILED
  UNREACHABLE
  TIMEOUT
}

// Shared platform currency (ISO-4217). Introduced with LCR (Phase 12J); reused
// by future rating/billing. Not USD-only.
enum Currency {
  USD
  EUR
  GBP
  INR
  AUD
  CAD
  JPY
}

// LCR route-selection strategy (Phase 12J) — declarative; evaluated by a FUTURE
// engine adapter, never here.
enum LcrSelectionStrategy {
  LOWEST_COST
  HIGHEST_PRIORITY
  WEIGHTED
  QUALITY_FIRST
}

enum TelecomCredentialType {
  SIP_PASSWORD
  CARRIER_API
  ENGINE_API // engine management-plane credential (e.g. mTLS client cert / JSONRPC auth)
  NODE_AGENT // node-agent heartbeat credential (mTLS client cert) — ADR-0020
}

enum ConfigChangeType {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
}

enum HealthEntityType {
  NODE
  CARRIER
  ENGINE
}

// --- Region (platform) -----------------------------------------------------
model Region {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code           String        @unique // e.g. "us-east"
  name           String
  country        String        @db.Char(2) // ISO-3166-1 alpha-2
  timezone       String // IANA
  providerRegion String? // upstream provider's region id
  status         TelecomStatus @default(ACTIVE)

  failoverRegionId String?  @db.Uuid
  failoverRegion   Region?  @relation("RegionFailover", fields: [failoverRegionId], references: [id], onDelete: SetNull)
  failoverFor      Region[] @relation("RegionFailover")

  engines  TelecomEngine[]
  nodes    TelecomNode[]
  carriers Carrier[]
  dids     Did[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
}

// --- Telecom engine registry (platform, ADR-0007) --------------------------
model TelecomEngine {
  id          String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  type        TelecomEngineType
  provider    String?
  version     String?
  endpoint    String? // management/API host reference — NOT a secret
  environment TelecomEnvironment @default(DEVELOPMENT)
  status      TelecomStatus      @default(DISABLED) // DISABLED until genuinely connected

  regionId String? @db.Uuid
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  // Management-plane credential reference (vault, ADR-0009). NEVER a plaintext
  // secret; decryption happens only at the adapter boundary. SetNull so deleting
  // a credential never orphans/deletes the engine row.
  credentialId String?            @db.Uuid
  credential   TelecomCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  capabilities        EngineCapability[]
  nodes               TelecomNode[]
  resourceAssignments EngineResourceAssignment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([type])
  @@index([status])
  @@index([regionId])
  @@index([credentialId])
}

model EngineCapability {
  id         String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  engineId   String              @db.Uuid
  engine     TelecomEngine       @relation(fields: [engineId], references: [id], onDelete: Cascade)
  capability EngineCapabilityKey
  enabled    Boolean             @default(true)

  createdAt DateTime @default(now())

  @@unique([engineId, capability])
}

// --- Engine ↔ resource assignment (platform; Phase 12N) --------------------
// Which tenant/platform resources are deployed to which engine. A future
// EngineConfigurationIntent is built from the ENABLED, non-deleted rows here.
// Exactly ONE resource FK is set and must match `kind` (enforced by a DB CHECK
// in the migration). Platform-managed (PlatformGuard); `tenantId` is the
// denormalized owner (null = platform resource) for scope + audit.
enum EngineResourceKind {
  SIP_TRUNK
  DID
  ROUTING_PROFILE
}

model EngineResourceAssignment {
  id       String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  engineId String             @db.Uuid
  engine   TelecomEngine      @relation(fields: [engineId], references: [id], onDelete: Cascade)
  kind     EngineResourceKind
  tenantId String?            @db.Uuid // denormalized owner (null = platform resource)
  tenant   Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Exactly ONE of these is non-null, matching `kind` (DB CHECK). Cascade so a
  // hard-deleted resource takes its assignment with it.
  sipTrunkId       String?         @db.Uuid
  sipTrunk         SipTrunk?       @relation(fields: [sipTrunkId], references: [id], onDelete: Cascade)
  didId            String?         @db.Uuid
  did              Did?            @relation(fields: [didId], references: [id], onDelete: Cascade)
  routingProfileId String?         @db.Uuid
  routingProfile   RoutingProfile? @relation(fields: [routingProfileId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // A resource is assigned at most once per engine. NULLs are distinct in PG, so
  // each unique constrains only its own kind's (non-null) rows.
  @@unique([engineId, sipTrunkId])
  @@unique([engineId, didId])
  @@unique([engineId, routingProfileId])
  @@index([engineId, enabled])
  @@index([tenantId])
  @@index([kind])
}

// --- Telecom node: CONFIG (durable) ----------------------------------------
model TelecomNode {
  id                 String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name               String
  engineId           String             @db.Uuid
  engine             TelecomEngine      @relation(fields: [engineId], references: [id], onDelete: Restrict)
  regionId           String?            @db.Uuid
  region             Region?            @relation(fields: [regionId], references: [id], onDelete: SetNull)
  zone               String?
  environment        TelecomEnvironment @default(DEVELOPMENT)
  hostRef            String? // address reference — NOT a secret
  status             TelecomStatus      @default(DISABLED)
  version            String?
  maxCps             Int? // capacity ceiling (config, not live value)
  maxConcurrentCalls Int?

  // Node-agent heartbeat credential reference (vault, ADR-0009/ADR-0020). A
  // reference only — the mTLS material lives in the vault, never on this row.
  // SET NULL so revoking a credential never orphans/deletes the node row.
  credentialId String?            @db.Uuid
  credential   TelecomCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  health NodeHealth?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([engineId])
  @@index([regionId])
  @@index([status])
  @@index([credentialId])
}

// --- Node health: RUNTIME snapshot (ephemeral, 1:1) ------------------------
model NodeHealth {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  nodeId          String       @unique @db.Uuid
  node            TelecomNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  status          HealthStatus @default(UNKNOWN)
  latencyMs       Int?
  lastHeartbeatAt DateTime?
  updatedAt       DateTime     @updatedAt
}

// --- Health events: append-only status transitions -------------------------
model HealthEvent {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entityType    HealthEntityType
  entityId      String           @db.Uuid
  tenantId      String?          @db.Uuid // null for platform entities
  fromStatus    HealthStatus?
  toStatus      HealthStatus
  reason        String?
  correlationId String?
  createdAt     DateTime         @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([tenantId, createdAt])
}

// --- Carrier (platform/wholesale when tenantId null, else tenant; ADR-0008) -
model Carrier {
  id                 String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String?       @db.Uuid // null = platform/wholesale
  tenant             Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  type               CarrierType   @default(BIDIRECTIONAL)
  country            String?       @db.Char(2)
  regionId           String?       @db.Uuid
  region             Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)
  status             TelecomStatus @default(DISABLED)
  priority           Int           @default(100) // config; LCR deferred
  codecs             Codec[]
  maxCps             Int?
  maxConcurrentCalls Int?

  credentialId String?            @db.Uuid
  credential   TelecomCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  sipEndpoints CarrierSipEndpoint[]
  sipTrunks    SipTrunk[]
  dids         Did[]
  routingRules RoutingRule[]
  lcrRoutes    LcrRoute[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, status])
  @@index([status])
  @@index([regionId])
}

model CarrierSipEndpoint {
  id        String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  carrierId String       @db.Uuid
  carrier   Carrier      @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  host      String
  port      Int          @default(5060)
  transport SipTransport @default(UDP)
  tls       Boolean      @default(false)
  priority  Int          @default(100)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([carrierId])
}

// --- SIP trunk (tenant-owned) ----------------------------------------------
model SipTrunk {
  id                 String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String            @db.Uuid
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Every trunk connects to a carrier (Phase 12F). Restrict: a carrier with
  // trunks cannot be hard-deleted (carriers soft-delete in practice).
  carrierId          String            @db.Uuid
  carrier            Carrier           @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  name               String
  direction          SipTrunkDirection @default(BIDIRECTIONAL)
  sipUri             String?
  host               String?
  port               Int               @default(5060)
  transport          SipTransport      @default(UDP)
  tls                Boolean           @default(false)
  authMode           SipAuthMode       @default(CREDENTIALS)
  allowedIps         String[] // IP-auth ACL
  codecs             Codec[]
  srtp               Boolean           @default(false)
  dtmfMode           String? // e.g. "rfc2833" — simple config for now
  maxCps             Int?
  maxConcurrentCalls Int?
  status             TelecomStatus     @default(DISABLED)

  credentialId String?            @db.Uuid
  credential   TelecomCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  dids              Did[]
  lcrRoutes         LcrRoute[]
  engineAssignments EngineResourceAssignment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, status])
  @@index([carrierId])
}

// --- DID (nullable tenant: null = platform inventory pool, set = assigned) --
model Did {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  e164       String    @unique // +14155550100 (partial-unique-on-live deferred)
  tenantId   String?   @db.Uuid
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  country    String    @db.Char(2)
  regionId   String?   @db.Uuid
  region     Region?   @relation(fields: [regionId], references: [id], onDelete: SetNull)
  carrierId  String?   @db.Uuid
  carrier    Carrier?  @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  // Optional delivery trunk (Phase 12G). SetNull: losing the trunk must not
  // delete the DID. Consistency (trunk.carrierId == carrierId) enforced in app.
  sipTrunkId String?   @db.Uuid
  sipTrunk   SipTrunk? @relation(fields: [sipTrunkId], references: [id], onDelete: SetNull)
  status     DidStatus @default(AVAILABLE)
  assignedAt DateTime?

  routingProfileId String?         @db.Uuid
  routingProfile   RoutingProfile? @relation(fields: [routingProfileId], references: [id], onDelete: SetNull)

  engineAssignments EngineResourceAssignment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, status])
  @@index([status])
  @@index([carrierId])
  @@index([sipTrunkId])
  @@index([routingProfileId])
  @@index([regionId])
  @@index([country])
}

// --- Routing profile (tenant-owned) + rules --------------------------------
model RoutingProfile {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String           @db.Uuid
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  direction   RoutingDirection @default(INBOUND)
  description String?
  status      TelecomStatus    @default(ACTIVE)

  // Routing policy (Phase 12I) — declarative; NOT executed. Loop protection via
  // bounded maxAttempts; `version` gives optimistic-concurrency on updates.
  selectionStrategy     RoutingSelectionStrategy   @default(PRIORITY)
  failoverEnabled       Boolean                    @default(false)
  failoverConditions    RoutingFailoverCondition[]
  maxAttempts           Int? // bounded attempt cap (loop protection)
  overallTimeoutSeconds Int?
  version               Int                        @default(0)

  rules             RoutingRule[]
  dids              Did[]
  engineAssignments EngineResourceAssignment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RoutingRule {
  id                      String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  routingProfileId        String                  @db.Uuid
  routingProfile          RoutingProfile          @relation(fields: [routingProfileId], references: [id], onDelete: Cascade)
  priority                Int                     @default(100)
  destinationType         RoutingDestinationType
  destination             String // validated per destinationType (Phase 12H) — declarative config
  carrierId               String?                 @db.Uuid
  carrier                 Carrier?                @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  // Retry/timeout are bounded CONFIG — never executed in 12H.
  timeoutSeconds          Int?
  retryCount              Int?
  weight                  Int? // for the WEIGHTED selection strategy (config only)
  // Optional declarative schedule: { timezone, daysOfWeek[], startMinute, endMinute } (validated at write).
  schedule                Json?
  // FailoverPolicy stays as fields (12A). Phase 12I types the failover destination
  // so it is validated like the primary and self-loops are rejected.
  failoverDestination     String?
  failoverDestinationType RoutingDestinationType?
  failoverAfterSeconds    Int?
  enabled                 Boolean                 @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([routingProfileId, priority])
}

// --- LCR policy (Phase 12J): tenant-owned route-SELECTION policy. -----------
// Distinct from RoutingProfile (inbound delivery): LCR picks an outbound carrier
// by cost/priority/prefix. Declarative only — NOTHING is executed here, and this
// is route selection, NOT call rating or billing.
model LcrPolicy {
  id                String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String               @db.Uuid
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  selectionStrategy LcrSelectionStrategy @default(LOWEST_COST)
  enabled           Boolean              @default(true)
  version           Int                  @default(0) // optimistic concurrency

  routes LcrRoute[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, name])
  @@index([tenantId])
}

// A candidate route within an LCR policy. `costMicros` is an INTEGER in
// millionths of a currency unit (no floating point) — a SELECTION cost, not a
// billed amount. Carrier/trunk are references (never duplicated / no secrets).
model LcrRoute {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  lcrPolicyId   String    @db.Uuid
  lcrPolicy     LcrPolicy @relation(fields: [lcrPolicyId], references: [id], onDelete: Cascade)
  carrierId     String    @db.Uuid
  carrier       Carrier   @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  sipTrunkId    String?   @db.Uuid
  sipTrunk      SipTrunk? @relation(fields: [sipTrunkId], references: [id], onDelete: SetNull)
  prefix        String // E.164-style destination prefix (e.g. "44", "9198")
  country       String?   @db.Char(2)
  costMicros    BigInt // millionths of a currency unit; integer, non-negative
  currency      Currency
  priority      Int       @default(100)
  weight        Int? // for WEIGHTED strategy
  enabled       Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([lcrPolicyId, prefix])
  @@index([lcrPolicyId, enabled])
  @@index([carrierId])
}

// --- Telecom credential vault (ADR-0009) -----------------------------------
// Secret material ONLY. secretEnc is AES-256-GCM and is NEVER exposed via any
// API DTO, log, or audit entry; decryption happens only at the adapter boundary.
model TelecomCredential {
  id        String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String?               @db.Uuid // null = platform (wholesale carriers)
  tenant    Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      TelecomCredentialType
  label     String
  hint      String? // non-secret (e.g. username or last-4)
  secretEnc String // AES-256-GCM (iv.ct.tag) — NEVER returned to clients
  rotatedAt DateTime?

  carriers  Carrier[]
  sipTrunks SipTrunk[]
  engines   TelecomEngine[]
  nodes     TelecomNode[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
}

// --- Config versioning: append-only, secret-free ---------------------------
model TelecomConfigVersion {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String?          @db.Uuid
  entityType     String // carrier | sip_trunk | did | routing_profile | node | engine
  entityId       String           @db.Uuid
  changeType     ConfigChangeType
  previousConfig Json? // secret-free snapshot
  newConfig      Json? // secret-free snapshot
  actorId        String?          @db.Uuid
  correlationId  String?
  createdAt      DateTime         @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([tenantId, createdAt])
}

// --- Fraud control plane (Phase 12R, ADR-0021) -----------------------------
// Append-only, immutable, tenant-scoped record of fraud-relevant occurrences.
// This slice (12R-1) establishes the event store + a read API only — there is
// NO enforcement (no spend/velocity/geo/destination/kill-switch control, no
// call authorization, no engine wiring). Mirrors the HealthEvent/SecurityEvent
// append-only pattern. Deliberately has no updatedAt/deletedAt and no mutable
// status, to stay tamper-evident (ADR-0021 §5).
enum FraudEventType {
  AUTHORIZATION_DENIED
  LIMIT_WARNING
  KILL_SWITCH
  POLICY_CHANGE
  ANOMALY
}

enum FraudEventSeverity {
  INFO
  WARNING
  CRITICAL
}

model FraudEvent {
  id            String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String             @db.Uuid
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          FraudEventType
  severity      FraudEventSeverity @default(WARNING)
  // The control that raised it, e.g. "velocity" | "spend" | "geo" | "kill-switch".
  source        String
  // Short machine reason code, e.g. "DAILY_SPEND_EXCEEDED".
  code          String
  // Safe human-readable text (bounded; never secrets or PII).
  reason        String?
  // Ties to a call attempt / request; set by future producers.
  correlationId String?
  // The user whose action raised it, when applicable; system-raised events = null.
  actorId       String?            @db.Uuid
  // Bounded, structured context; never secrets or unnecessary PII.
  metadata      Json?
  createdAt     DateTime           @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([tenantId, severity, createdAt])
}

// --- Fraud control plane (Phase 12R-2a, ADR-0021) --------------------------
// Tenant-authored spend limits — DECLARATIVE CONFIG ONLY. This slice stores and
// manages the limits; NOTHING reads or enforces them yet (no call authorization,
// no reservation, no balance gate — those are later slices). Money is an INTEGER
// minor-unit micro amount, currency-tagged — never floating point. Optimistic
// concurrency via `version`; soft-delete via `deletedAt`. At most one active
// (non-deleted) limit per (tenant, period) — enforced in the service (the
// soft-delete-aware partial unique index is deferred, as for Did.e164).
enum SpendLimitPeriod {
  PER_CALL
  DAILY
  MONTHLY
}

model SpendLimit {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String           @db.Uuid
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period       SpendLimitPeriod
  // Integer millionths of a currency unit (micros) — no floating point.
  amountMicros BigInt
  currency     Currency         @default(USD)
  enabled      Boolean          @default(true)
  version      Int              @default(1)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  @@index([tenantId, period])
  @@index([tenantId])
}

// --- Fraud control plane (Phase 12R-2b, ADR-0021) --------------------------
// Tenant-authored velocity limits — DECLARATIVE CONFIG ONLY. Stores and manages
// the limits; NOTHING reads, counts, or enforces them yet (no call rate check,
// no concurrent-call gauge — later slices). `limit` is an integer count (not
// money). Optimistic concurrency via `version`; soft-delete. At most one active
// limit per (tenant, metric), enforced in the service.
enum VelocityMetric {
  CALLS_PER_MINUTE
  CALLS_PER_HOUR
  CALLS_PER_DAY
  CONCURRENT_CALLS
}

model VelocityLimit {
  id        String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String         @db.Uuid
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metric    VelocityMetric
  // Max count per the metric's window (or the concurrent-call cap). Integer.
  limit     Int
  enabled   Boolean        @default(true)
  version   Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  @@index([tenantId, metric])
  @@index([tenantId])
}

// --- Fraud control plane (Phase 12R-2c, ADR-0021) --------------------------
// Tenant-authored geo + destination rules — DECLARATIVE CONFIG ONLY. Stores and
// manages allow/deny rules keyed by COUNTRY (ISO-3166-1 alpha-2) or by dial
// PREFIX (E.164 prefix), with an optional risk class. NOTHING evaluates, matches,
// or enforces these yet (no call normalization, no geo/destination decision —
// later slices). Optimistic concurrency via `version`; soft-delete. At most one
// active rule per (tenant, matchType, matchValue), enforced in the service. The
// per-tenant default action (allow/deny when no rule matches) is a later policy
// envelope, not modelled here.
enum DestinationMatchType {
  COUNTRY
  PREFIX
}

enum DestinationAction {
  ALLOW
  DENY
}

enum DestinationRiskClass {
  STANDARD
  HIGH_COST
  PREMIUM
}

model DestinationRule {
  id         String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String               @db.Uuid
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matchType  DestinationMatchType
  // COUNTRY → ISO-3166-1 alpha-2 (uppercase). PREFIX → digits (no leading +),
  // normalized in the service before storage/uniqueness.
  matchValue String
  action     DestinationAction
  riskClass  DestinationRiskClass @default(STANDARD)
  enabled    Boolean              @default(true)
  version    Int                  @default(1)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  deletedAt  DateTime?

  @@index([tenantId, matchType])
  @@index([tenantId])
}

// --- Fraud control plane (Phase 12R-3, ADR-0021) ---------------------------
// Emergency kill-switch STATE — stores and toggles the switch; NOTHING reads or
// enforces it at call time yet (no call authorization — that is the later
// Authorization Decision Service). Two scopes: GLOBAL (platform-wide, tenantId
// null, platform-operator only) and TENANT (a tenant's own calling). Dual-nature
// nullable tenantId → NOT in TENANT_SCOPED_MODELS; scoping is explicit in the
// service. Each toggle is audited and emits a KILL_SWITCH FraudEvent (12R-1).
// Step-up MFA on activation is a later enforcement/auth concern (deferred).
enum KillSwitchScope {
  GLOBAL
  TENANT
}

model KillSwitch {
  id            String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  scope         KillSwitchScope
  // GLOBAL → null (platform-wide); TENANT → the owning tenant.
  tenantId      String?         @db.Uuid
  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  active        Boolean         @default(false)
  // Safe human-readable reason (bounded; never secrets/PII).
  reason        String?
  activatedAt   DateTime?
  activatedBy   String?         @db.Uuid
  deactivatedAt DateTime?
  deactivatedBy String?         @db.Uuid
  version       Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // One switch per tenant (TENANT scope). GLOBAL singleton (tenantId null) is
  // enforced in the service — Postgres treats NULLs as distinct here.
  @@unique([scope, tenantId])
  @@index([scope])
}

// --- Fraud control plane (Phase 12R-6, ADR-0021) ---------------------------
// Spend-reservation ledger — the durable record of estimated call cost HELD
// against a tenant's period spend caps while a call is in flight, so concurrent
// authorizations cannot each individually pass a period cap and collectively
// blow through it. STATE/MECHANISM ONLY: nothing places a reservation at call
// time yet (the engine-wired call-authorization path is a later slice). The hot
// per-period reserved total is a Redis gauge (fail-closed) that is reconcilable
// from these rows; these rows are the source of truth + audit + idempotency
// guard. Money is integer micros (never float). Settled actuals fold into the
// billing ledger (Phase 13); until then a period cap reflects in-flight
// reservations only. One live hold per (tenant, idempotencyKey) — the retry
// guard. Designed for time-based partitioning as call volume arrives.
enum SpendReservationStatus {
  ACTIVE // reserved; call in flight
  SETTLED // call completed; actual cost recorded (settledMicros)
  RELEASED // call never placed / failed / cancelled; hold returned
  EXPIRED // TTL elapsed while still ACTIVE; swept and returned
}

model SpendReservation {
  id             String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String                 @db.Uuid
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Dedupes retries of the same call-authorization attempt (one hold per key).
  idempotencyKey String
  // Reserved (estimated) cost in integer micros; actual recorded on settle.
  amountMicros   BigInt
  settledMicros  BigInt?
  currency       Currency               @default(USD)
  status         SpendReservationStatus @default(ACTIVE)
  // Ties to the call attempt; set by the future call-authorization path.
  correlationId  String?
  // TTL: an ACTIVE reservation past this is swept to EXPIRED (hold returned).
  expiresAt      DateTime
  settledAt      DateTime?
  releasedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  // One live hold per retry key; also the idempotency guard (service upserts).
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  // Drives the TTL sweeper (find overdue ACTIVE holds across tenants).
  @@index([status, expiresAt])
}

// ===========================================================================
// Billing ledger foundation — Phase 13, Slice 13-1 (ADR-0022 Accepted;
// design: docs/LEDGER_FOUNDATION.md). The append-only, double-entry ledger
// spine every billing operation posts to. These four models are the ONLY
// Prisma-managed ledger objects; the restricted SECURITY DEFINER posting
// function `billing.ledger_post`, the deferred balancing/immutability triggers,
// the NULLS NOT DISTINCT unique indexes, the amount CHECK bounds, and the
// `billing` schema are created as raw SQL in the same migration (not expressible
// in schema.prisma — LEDGER_FOUNDATION §20). The runtime role holds NO direct
// DML on these tables; the posting function is the only write path (§14/§17).
//
// Dual-nature ownership (ADR-0008, NOT in TENANT_SCOPED_MODELS): nullable tenant
// (null = platform). Delete is RESTRICT everywhere (financial history is never
// cascade-deleted). Money = signed BIGINT micros (debit +, credit −), never
// float (LF-01/R5). Timestamps are timestamptz (financial-record precision).
// ===========================================================================

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

enum LedgerNormalBalance {
  DEBIT
  CREDIT
}

enum LedgerAccountStatus {
  ACTIVE
  RETIRED // never deleted; delete is RESTRICT (R1)
}

/// A chart-of-accounts node. Dual-nature (ADR-0008): tenant-owned (customer
/// liability) when tenantId is set, platform-owned (revenue/COGS/promo/suspense)
/// when null. Identity attributes (ownership, currency, type, normalBalance,
/// code) are IMMUTABLE once created — enforced by a BEFORE-UPDATE trigger AND by
/// denying the runtime role UPDATE (R1). Retired, never deleted.
model LedgerAccount {
  id            String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String?             @db.Uuid
  tenant        Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  currency      Currency // immutable
  code          String // chart-of-accounts code; immutable
  name          String // descriptive; mutable
  type          LedgerAccountType // immutable
  normalBalance LedgerNormalBalance // immutable
  status        LedgerAccountStatus @default(ACTIVE)
  retiredAt     DateTime?           @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)

  legs LedgerLeg[]

  // Natural identity, deduped per owner (platform = null). The raw-SQL migration
  // makes this UNIQUE ... NULLS NOT DISTINCT (PG18) so platform accounts (null
  // tenant) are also deduped without a sentinel (LF §16).
  @@unique([tenantId, currency, code])
  // Composite-FK target for LedgerLeg(accountId, currency) — pins a leg's
  // currency to its account's currency at the database level.
  @@unique([id, currency])
  @@index([tenantId, type])
}

/// An atomic, IMMUTABLE financial event grouping legs. No updatedAt — a posted
/// transaction is never edited; corrections are compensating transactions
/// (reversalOfId). One tenant owner at most (ownerTenantId; null = platform).
model LedgerTransaction {
  id            String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  operation     String // e.g. fund / adjust / reverse / settle (per-op matrix is 13-3+)
  ownerTenantId String?             @db.Uuid
  ownerTenant   Tenant?             @relation(fields: [ownerTenantId], references: [id], onDelete: Restrict)
  currency      Currency // single currency for the whole transaction (decision 2)
  effectiveAt   DateTime            @db.Timestamptz(6)
  correlationId String?
  sourceType    String? // provenance
  sourceRef     String?
  // Actor attribution (adjustments require it). Plain uuid, matching the repo's
  // audit-actor convention (AuditLog/FraudEvent): no FK — a system identity has no User row.
  actorId       String?             @db.Uuid
  reversalOfId  String?             @db.Uuid
  reversalOf    LedgerTransaction?  @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals     LedgerTransaction[] @relation("LedgerReversal")
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)

  legs           LedgerLeg[]
  idempotencyKey IdempotencyKey? // 1:1 via IdempotencyKey.resultTransactionId (unique)
  // Financial audit back-relation (Phase 13-2B S2) — no column on this table.
  financialAuditEvents FinancialAuditEvent[]

  @@index([ownerTenantId, effectiveAt])
  @@index([correlationId])
}

/// A signed posting against a LedgerAccount. Posted legs are IMMUTABLE. The
/// composite FK (accountId, currency) → LedgerAccount(id, currency) pins the
/// leg's currency to its account. amountMicros is signed and CHECK'd <> 0 and
/// within ±1e15 micros (raw SQL) — debit +, credit − (LF-01/R5).
model LedgerLeg {
  id            String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  transactionId String            @db.Uuid
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String            @db.Uuid
  currency      Currency
  account       LedgerAccount     @relation(fields: [accountId, currency], references: [id, currency], onDelete: Restrict)
  amountMicros  BigInt // signed micros; raw-SQL CHECK (<> 0 AND within ±1e15)
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)

  @@index([transactionId])
  @@index([accountId])
}

/// The single, non-time-partitioned financial idempotency registry (D4). A key
/// is CLAIMED (resultTransactionId NULL) before the transaction exists, then
/// linked; a deferred constraint trigger re-reads the final row at COMMIT and
/// rejects an incomplete claim (LF §16). Completed records are immutable; no
/// expiry (no historical double-posting).
model IdempotencyKey {
  id                  String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String?            @db.Uuid
  tenant              Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  operation           String
  key                 String
  requestFingerprint  String // server-generated canonical payload hash
  fingerprintVersion  Int
  // Nullable only inside the posting transaction (claim window); a deferred
  // constraint trigger forbids an incomplete record from committing. UNIQUE so a
  // transaction is claimed by exactly one key.
  resultTransactionId String?            @unique @db.Uuid
  resultTransaction   LedgerTransaction? @relation(fields: [resultTransactionId], references: [id], onDelete: Restrict)
  createdAt           DateTime           @default(now()) @db.Timestamptz(6)

  // Deduped per (owner, operation). The raw-SQL migration makes this
  // UNIQUE ... NULLS NOT DISTINCT (PG18) so platform (null tenant) ops dedupe
  // without a sentinel (D4 / R4).
  @@unique([tenantId, operation, key])
}

// ===========================================================================
// Commercial billing account foundation — Phase 13-2B, Slice S3
// (ADR-0022 Amendment 5: BA-01, BA-02, BA-04, BA-05, BA-06 [database part],
// BA-13, X-1; owner S3 decisions S3-D1..D4, 2026-11-26).
//
// INERT FOUNDATION: no endpoint, service, caller or rows exist in S3, and the
// runtime role (telvyn_app) holds NO privilege on this table (owner decision E,
// least privilege). SELECT/INSERT arrive with S5 (provisioning), column-level
// UPDATE with S6 (lifecycle), reads with S8 — never DELETE (BA-13).
//
// Raw SQL in the migration (not expressible in schema.prisma; verified by
// scripts/db/ledger-drift-check.sql, NOT by Prisma schema-diff — always review
// generated migrations with --create-only so these are never dropped):
//   * partial unique index: one default account per (tenantId, currency) among
//     ACTIVE/SUSPENDED accounts (BA-02);
//   * partial expression unique index: label unique per tenant ignoring case and
//     surrounding whitespace among non-CLOSED accounts (BA-02, S3-D1);
//   * CHECKs: label non-empty after trim (S3-D1); no self-succession (S3-D2);
//   * billing.billing_account_guard trigger: owner/currency/mode/number/lineage/
//     provisioning identity immutable; new rows start ACTIVE; CLOSED is terminal
//     (BA-01/04/05/06, S3-D3); tenant must be CUSTOMER or RESELLER (BA-01).
// The full lifecycle transition matrix is NOT enforced here — it is approved and
// implemented with S6 (S3-D3).
//
// No deletedAt (X-1): CLOSED replaces deletion; history is never removed.
// ===========================================================================

enum BillingMode {
  PREPAID
  POSTPAID
}

enum BillingAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSING
  CLOSED
}

/// A tenant-owned commercial billing account (BA-01). One currency and one mode,
/// both immutable (BA-04/BA-05); a mode change opens a successor account
/// (owner decision 5). Provisioning idempotency lives on the row (BA-03).
model BillingAccount {
  id                      String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId                String               @db.Uuid // immutable owner (BA-01)
  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accountNumber           String               @unique // immutable; format decided before S5
  label                   String // required; unique per tenant ignoring case among non-CLOSED (raw SQL)
  currency                Currency // immutable (BA-04)
  mode                    BillingMode // immutable (BA-05)
  status                  BillingAccountStatus @default(ACTIVE)
  statusChangedAt         DateTime             @default(now()) @db.Timestamptz(6)
  isDefault               Boolean              @default(false)
  // Lineage (S3-D2): this account succeeds `successorOfId`. Same tenant enforced
  // by the composite FK; at most one successor per account; set at insert only.
  successorOfId           String?              @db.Uuid
  predecessor             BillingAccount?      @relation("BillingAccountLineage", fields: [successorOfId, tenantId], references: [id, tenantId], onDelete: Restrict)
  successor               BillingAccount?      @relation("BillingAccountLineage")
  // Provisioning idempotency (BA-03): same key + same fingerprint replays; same
  // key + different fingerprint is rejected by the provisioning service (S5).
  provisioningKey         String
  provisioningFingerprint String
  createdAt               DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime             @updatedAt @db.Timestamptz(6)

  // Financial audit back-relation (Phase 13-2B S2) — no column on this table.
  financialAuditEvents FinancialAuditEvent[]

  @@unique([id, tenantId]) // composite-FK target for same-tenant lineage (and S2 audit attribution)
  @@unique([successorOfId, tenantId]) // at most one successor per account
  @@unique([tenantId, provisioningKey])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Financial step-up grant (ADR-0022 Amendment 5 BA-15, Phase 13-2B S1).
// A server-side, single-use proof that the actor re-verified a fresh TOTP code,
// bound to user + session + tenant + purpose, valid for 300 s (owner-approved
// G1, 2026-11-26; also enforced by a DB CHECK). Issued and consumed only by
// StepUpService; INERT in S1 (no endpoint, no operation requires it yet).
// No updatedAt/deletedAt: the only mutation is the single consumedAt stamp
// (runtime holds column-level UPDATE on consumedAt only); grants are evidence
// and are never deleted (FKs RESTRICT, no runtime DELETE).
// ---------------------------------------------------------------------------
model StepUpGrant {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionId  String    @db.Uuid
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  tenantId   String    @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purpose    String
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  // Financial audit back-relation (Phase 13-2B S2) — no column on this table.
  financialAuditEvents FinancialAuditEvent[]

  @@index([userId, sessionId])
  @@index([tenantId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Financial audit event (ADR-0022 Amendment 5 BA-14, Phase 13-2B S2; owner
// decisions F1–F7, 2026-11-27). A dedicated, APPEND-ONLY record of a financial
// state change, written by FinancialAuditWriter IN THE CALLER'S TRANSACTION
// (audit failure rolls the change back — fail closed). Distinct from AuditLog
// (operational events), SecurityEvent (authentication) and the ledger (money
// history): an audit row is never a substitute for a ledger entry.
//
// INERT in S2: the operation catalog is empty (F1 — the first operation is
// named in S5), so no production code path can write a row yet.
//
// Attribution (F3/F4): a HUMAN actor only (no system actor until service
// identities are designed, BA-15) — actorUserId + actorTenantId (the session's
// tenant) are distinct from tenantId (owner of the affected financial object),
// so a platform actor stays distinguishable from tenant ownership. The DB guard
// requires actorTenantId = tenantId unless the actor's tenant is PLATFORM.
// billingAccountId is pinned to tenantId by a composite FK (no cross-tenant
// reference is representable).
//
// Raw SQL in the migration (verified by scripts/db/ledger-drift-check.sql):
// format/size CHECKs (F5), the billing.financial_audit_event_guard trigger
// (no UPDATE / DELETE / TRUNCATE, attribution + step-up binding, DB-stamped
// createdAt — F6), and runtime SELECT + INSERT only (F6).
// No updatedAt/deletedAt: rows are evidence and are never changed or removed.
// ---------------------------------------------------------------------------
enum FinancialAuditDecision {
  ALLOWED // written in the caller's transaction by FinancialAuditWriter (S2)
  DENIED // reserved: the denied-attempt writer (own transaction) is S5 (F2)
}

model FinancialAuditEvent {
  id                  String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  operation           String // catalog identifier (F1), CHECK-formatted
  decision            FinancialAuditDecision
  actorUserId         String                 @db.Uuid
  actorUser           User                   @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorTenantId       String                 @db.Uuid
  actorTenant         Tenant                 @relation("FinancialAuditActorTenant", fields: [actorTenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenantId            String                 @db.Uuid // owner of the affected financial object
  tenant              Tenant                 @relation("FinancialAuditOwnerTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  billingAccountId    String?                @db.Uuid
  billingAccount      BillingAccount?        @relation(fields: [billingAccountId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  permission          String? // the permission key that authorized the operation
  stepUpGrantId       String?                @db.Uuid
  stepUpGrant         StepUpGrant?           @relation(fields: [stepUpGrantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reasonCode          String // CHECK ^[A-Z][A-Z0-9_]{2,63}$; no free text (F5)
  before              Json? // plain object, <= 4096 bytes, <= 50 keys (F5)
  after               Json?
  details             Json?
  idempotencyKey      String? // reference only — never unique, never deduplicated (F7)
  ledgerTransactionId String?                @db.Uuid
  ledgerTransaction   LedgerTransaction?     @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  correlationId       String?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime               @default(now()) @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([billingAccountId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actorTenantId, createdAt])
  @@index([stepUpGrantId])
  @@index([ledgerTransactionId])
  @@index([correlationId])
}
