# Telvyn — environment template. Copy to .env and fill real values.
# NEVER commit .env. All values below are non-secret local-dev placeholders.

NODE_ENV=development

# ---------- Web (apps/web) ----------
WEB_PORT=3211
WEB_ORIGIN=http://localhost:3211

# ---------- API (apps/api) ----------
API_PORT=3311

# ---------- PostgreSQL (docker-compose.dev.yml maps host port 5433) ----------
POSTGRES_DB=telvyn
POSTGRES_USER=telvyn
POSTGRES_PASSWORD=change_me_local_dev
DATABASE_URL=postgresql://telvyn:change_me_local_dev@localhost:5433/telvyn?schema=public

# ---------- Redis (docker-compose.dev.yml maps host port 6380) ----------
REDIS_URL=redis://localhost:6380

# ---------- Auth ----------
# openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# 32 bytes base64 (openssl rand -base64 32) — encrypts MFA secrets at rest
APP_ENCRYPTION_KEY=replace_with_32_byte_base64_key
# true in production (HTTPS) — controls Secure flag on the refresh cookie
COOKIE_SECURE=false
MFA_ISSUER=Telvyn

# ---------- Telecom engine management plane (Phase 12M) ----------
# Private-network allowlist for engine management endpoints. The default (unset /
# empty) keeps the strict public-only SSRF policy. To reach an engine over a
# private transport (e.g. a WireGuard mTLS gateway), authorize the SPECIFIC IP +
# port only — never a blanket RFC1918 range. Format: comma-separated CIDR@port
# (IPv4 /24..32, IPv6 exact /128; one or more ;-separated ports per entry).
# Example for the Phase 12M Kamailio test VPS over WireGuard:
# ENGINE_MGMT_ALLOWLIST=10.9.0.1/32@8443
#
# Which engine connector is wired. Default (unset / anything else) = the honest
# NullEngineConnector (NO network egress). Set to `kamailio` to engage the real
# JSONRPC health connector — even then, nothing is contacted until an engine has
# a management endpoint (allowlisted above) AND an ENGINE_API credential.
# ENGINE_CONNECTOR=kamailio
#
# The ENGINE_API vault credential's secret is a JSON mTLS bundle (stored encrypted
# via the credential vault, never in this file):
#   {"cert":"-----BEGIN CERTIFICATE-----…","key":"-----BEGIN PRIVATE KEY-----…","ca":"-----BEGIN CERTIFICATE-----…"}
