# Telvyn — ISOLATED Ledger Foundation dev/test environment (Slice 13-1A) — TEMPLATE.
#
# Copy to `.env.ledger-dev` (gitignored) and set a STRONG, random POSTGRES_PASSWORD.
# This environment is DEDICATED, NON-PRODUCTION, and localhost-only (127.0.0.1:5434).
# It is NOT the existing dev DBs on 5432/5433 and holds no production data.
#
# The POSTGRES_USER below is the one-time BOOTSTRAP ADMIN for this isolated cluster.
# It is NOT the application runtime role. The least-privilege application roles
# (telvyn_migrator, telvyn_ledger_fn, telvyn_app) are created in Slice 13-1A.4,
# under separate authorization — not here.

POSTGRES_DB=telvyn_ledger_dev
POSTGRES_USER=telvyn_ledger_admin
POSTGRES_PASSWORD=__generate_a_strong_random_password_in_.env.ledger-dev__

# Bootstrap-admin connection string (local only; fill from the real .env.ledger-dev):
#   DATABASE_URL=postgresql://telvyn_ledger_admin:<password>@127.0.0.1:5434/telvyn_ledger_dev?schema=public
